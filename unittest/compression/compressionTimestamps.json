{
  "tests": [
    {
      "name": "EmptyTimestampsTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with empty unix timestamps array",
      "input": {
        "unix_timestamps": []
      },
      "expected": {
        "first_unix_timestamp_ms": 0,
        "sections_sizes": [],
        "inner_sections_durations_ms": [],
        "outer_sections_durations_ms": []
      }
    },
    {
      "name": "OneTimestampTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with one unix timestamp",
      "input": {
        "unix_timestamps": [1]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [1],
        "inner_sections_durations_ms": [0],
        "outer_sections_durations_ms": [0]
      }
    },
    {
      "name": "OneSectionTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with one section",
      "input": {
        "unix_timestamps": [1, 2, 3, 4]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [4],
        "inner_sections_durations_ms": [1],
        "outer_sections_durations_ms": [0]
      }
    },
    {
      "name": "TwoSectionTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with two sections",
      "input": {
        "unix_timestamps": [1, 2, 3, 4, 6, 7, 8, 9]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [4, 4],
        "inner_sections_durations_ms": [1, 1],
        "outer_sections_durations_ms": [0, 5]
      }
    },
    {
      "name": "ThreeSectionTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with three sections",
      "input": {
        "unix_timestamps": [1, 2, 3, 4, 6, 7, 8, 9, 11, 12, 13]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [4, 4, 3],
        "inner_sections_durations_ms": [1, 1, 1],
        "outer_sections_durations_ms": [0, 5, 5]
      }
    },
    {
      "name": "LastSingleTimestampSectionTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with two sections and last section is one single timestamp",
      "input": {
        "unix_timestamps": [1, 2, 3, 4, 6]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [4, 1],
        "inner_sections_durations_ms": [1, 0],
        "outer_sections_durations_ms": [0, 5]
      }
    },
    {
      "name": "FirstSingleTimestampSectionTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with two sections and first timestamp is separated",
      "input": {
        "unix_timestamps": [1, 3, 4, 5, 6]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [2, 3],
        "inner_sections_durations_ms": [2, 1],
        "outer_sections_durations_ms": [0, 3]
      }
    },
    {
      "name": "ThreeSectionDifferentGapsWithSingleTimeStampTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with three sections and different gaps between the sections, where the middle section consists of two timestamps",
      "input": {
        "unix_timestamps": [1, 2, 3, 5, 8, 9, 10]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [3, 2, 2],
        "inner_sections_durations_ms": [1, 3, 1],
        "outer_sections_durations_ms": [0, 4, 4]
      }
    },
    {
      "name": "ThreeSectionDifferentGapsTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with three sections and different gaps between the sections",
      "input": {
        "unix_timestamps": [1, 2, 3, 5, 6, 7, 10, 11, 12]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [3, 3, 3],
        "inner_sections_durations_ms": [1, 1, 1],
        "outer_sections_durations_ms": [0, 4, 5]
      }
    },
    {
      "name": "ThreeSectionDifferentBigGapsTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with three sections that have different inner durations and bigger gaps between the sections",
      "input": {
        "unix_timestamps": [1, 2, 3, 4, 6, 9, 20, 24, 28]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [4, 2, 3],
        "inner_sections_durations_ms": [1, 3, 4],
        "outer_sections_durations_ms": [0, 5, 14]
      }
    },
    {
      "name": "FourSectionTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with four sections and different big gaps between the sections",
      "input": {
        "unix_timestamps": [1, 2, 3, 4, 6, 9, 12, 14, 15, 16, 20, 25]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [4, 3, 3, 2],
        "inner_sections_durations_ms": [1, 3, 1, 5],
        "outer_sections_durations_ms": [0, 5, 8, 6]
      }
    },
    {
      "name": "MixedSectionTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with five sections, different inner durations and a single timestamp in the last section",
      "input": {
        "unix_timestamps": [0, 2, 4, 5, 12, 13, 14, 15, 16, 20, 23, 26, 29, 32, 35, 38, 41, 50]
      },
      "expected": {
        "first_unix_timestamp_ms": 0,
        "sections_sizes": [3, 2, 4, 8, 1],
        "inner_sections_durations_ms": [2, 7, 1, 3, 0],
        "outer_sections_durations_ms": [0, 5, 8, 7, 30]
      }
    },
    {
      "name": "AllDifferentTimestampsDurationTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with three sections and each duration between the timestamps is different",
      "input": {
        "unix_timestamps": [1000, 1010, 1030, 1060, 1100]
      },
      "expected": {
        "first_unix_timestamp_ms": 1000,
        "sections_sizes": [2, 2, 1],
        "inner_sections_durations_ms": [10, 30, 0],
        "outer_sections_durations_ms": [0, 30, 70]
      }
    },
    {
      "name": "LargeInnerSectionDurationTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with an inner section duration of 3000000000 ms, which does not fit into a signed 32-bit integer",
      "input": {
        "unix_timestamps": [1, 3000000001]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [2],
        "inner_sections_durations_ms": [3000000000],
        "outer_sections_durations_ms": [0]
      }
    },
    {
      "name": "RealDataTest",
      "operation": "compress_timestamps",
      "purpose": "Tests timestamps compression with real data consisting of four sections",
      "input": {
        "unix_timestamps": [1675732789987, 1675732790027, 1675732790067, 1675732790107, 1675732790147, 1675732790187, 1675732790227, 1675732790267, 1675732790307, 1675732790347, 1675732790467, 1675732790507, 1675732790547, 1675732790587, 1675732790627, 1675732790667, 1675732790707, 1675732790747, 1675732790867, 1675732790947, 1675732791027, 1675732791107, 1675732791187, 1675732791347, 1675732791387, 1675732791427]
      },
      "expected": {
        "first_unix_timestamp_ms": 1675732789987,
        "sections_sizes": [10, 8, 5, 3],
        "inner_sections_durations_ms": [40, 40, 80, 40],
        "outer_sections_durations_ms": [0, 480, 400, 480]
      }
    }
  ]
}
