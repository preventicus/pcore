{
  "tests": [
    {
      "name": "PPGColorSensorTest",
      "operation": "compress_data",
      "purpose": "Test compressing data with a photoplethysmograph with a color and int values",
      "input": {
        "unix_timestamps": [1, 2, 3, 4, 5],
        "sensors": [
          {
            "photoplethysmograph": {
              "color": "COLOR_RED"
            },
            "int_values": [0, 3, 1, 3, 2]
          }
        ]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [5],
        "inner_sections_durations_ms": [1],
        "outer_sections_durations_ms": [0],
        "sensors": [
          {
            "photoplethysmograph": {
              "color": "COLOR_RED"
            },
            "int_values": [0, 3, -2, 2, -1]
          }
        ]
      }
    },
    {
      "name": "PPGWavelengthSensorTest",
      "operation": "compress_data",
      "purpose": "Test compressing data with a photoplethysmograph with a wavelength and double values",
      "input": {
        "unix_timestamps": [1, 2, 3],
        "sensors": [
          {
            "photoplethysmograph": {
              "wavelength_nm": 530
            },
            "double_values": [3.1234, 4.1234, 5.5]
          }
        ]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [3],
        "inner_sections_durations_ms": [1],
        "outer_sections_durations_ms": [0],
        "sensors": [
          {
            "photoplethysmograph": {
              "wavelength_nm": 530
            },
            "double_values": [3.1234, 4.1234, 5.5]
          }
        ]
      }
    },
    {
      "name": "ACCSensorTest",
      "operation": "compress_data",
      "purpose": "Test compressing data with an accelerometer with int values",
      "input": {
        "unix_timestamps": [1, 2, 3],
        "sensors": [
          {
            "accelerometer": {
              "type": "TYPE_X_COORDINATE"
            },
            "int_values": [3, 4, -1]
          }
        ]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [3],
        "inner_sections_durations_ms": [1],
        "outer_sections_durations_ms": [0],
        "sensors": [
          {
            "accelerometer": {
              "type": "TYPE_X_COORDINATE"
            },
            "int_values": [3, 1, -5]
          }
        ]
      }
    },
    {
      "name": "ECGSensorTest",
      "operation": "compress_data",
      "purpose": "Test compressing data with an electrocardiogram with int values",
      "input": {
        "unix_timestamps": [1, 2, 3],
        "sensors": [
          {
            "electrocardiogram": {
              "channel": 2
            },
            "int_values": [100, 200, 150]
          }
        ]
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [3],
        "inner_sections_durations_ms": [1],
        "outer_sections_durations_ms": [0],
        "sensors": [
          {
            "electrocardiogram": {
              "channel": 2
            },
            "int_values": [100, 100, -50]
          }
        ]
      }
    },
    {
      "name": "ChannelsTest",
      "operation": "compress_data",
      "purpose": "Test compressing data with sensors that differ only in their channel, and sensors of different types with the same channel",
      "input": {
        "unix_timestamps": [10, 20, 30],
        "sensors": [
          {
            "photoplethysmograph": {
              "wavelength_nm": 530,
              "channel": 3
            },
            "int_values": [1, 2, 3]
          },
          {
            "photoplethysmograph": {
              "wavelength_nm": 530,
              "channel": 4
            },
            "int_values": [7, 8, 9]
          },
          {
            "accelerometer": {
              "type": "TYPE_X_COORDINATE",
              "channel": 3
            },
            "int_values": [4, 5, 6]
          }
        ]
      },
      "expected": {
        "first_unix_timestamp_ms": 10,
        "sections_sizes": [3],
        "inner_sections_durations_ms": [10],
        "outer_sections_durations_ms": [0],
        "sensors": [
          {
            "photoplethysmograph": {
              "wavelength_nm": 530,
              "channel": 3
            },
            "int_values": [1, 1, 1]
          },
          {
            "photoplethysmograph": {
              "wavelength_nm": 530,
              "channel": 4
            },
            "int_values": [7, 1, 1]
          },
          {
            "accelerometer": {
              "type": "TYPE_X_COORDINATE",
              "channel": 3
            },
            "int_values": [4, 1, 1]
          }
        ]
      }
    },
    {
      "name": "TimeZoneOffsetTest",
      "operation": "compress_data",
      "purpose": "Test compressing data with a timezone offset",
      "input": {
        "unix_timestamps": [1, 2, 3],
        "sensors": [
          {
            "electrocardiogram": {
              "channel": 1
            },
            "int_values": [1, 2, 3]
          }
        ],
        "timezone_offset_min": -120
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [3],
        "inner_sections_durations_ms": [1],
        "outer_sections_durations_ms": [0],
        "sensors": [
          {
            "electrocardiogram": {
              "channel": 1
            },
            "int_values": [1, 1, 1]
          }
        ],
        "timezone_offset_min": -120
      }
    },
    {
      "name": "CompleteTest",
      "operation": "compress_data",
      "purpose": "Test compressing data with a timezone offset, two sections of timestamps and ten sensors of all types with int and double values",
      "input": {
        "unix_timestamps": [1, 2, 3, 13, 23],
        "sensors": [
          {
            "photoplethysmograph": {
              "color": "COLOR_RED"
            },
            "int_values": [0, 3, 1, 3, 2]
          },
          {
            "photoplethysmograph": {
              "color": "COLOR_GREEN"
            },
            "int_values": [3, 5, 2, 1, 4]
          },
          {
            "photoplethysmograph": {
              "color": "COLOR_BLUE"
            },
            "int_values": [0, 0, 0, 0, 0]
          },
          {
            "photoplethysmograph": {
              "wavelength_nm": 400
            },
            "int_values": [4, 6, 3, 2, 4]
          },
          {
            "accelerometer": {
              "type": "TYPE_X_COORDINATE"
            },
            "int_values": [0, 0, 0, -200, 0]
          },
          {
            "accelerometer": {
              "type": "TYPE_Y_COORDINATE"
            },
            "int_values": [0, 0, 0, 200, 0]
          },
          {
            "accelerometer": {
              "type": "TYPE_Z_COORDINATE"
            },
            "int_values": [0, 100, 0, -200, 0]
          },
          {
            "accelerometer": {
              "type": "TYPE_EUCLIDEAN_DIFFERENCES_NORM"
            },
            "double_values": [3.21274389, 8.723849, 400.782934, 43.83924, 64.34894]
          },
          {
            "electrocardiogram": {
              "channel": 1
            },
            "int_values": [0, 0, 0, 40, 0]
          },
          {
            "electrocardiogram": {
              "channel": 2
            },
            "int_values": [0, 40, 0, 20, 0]
          }
        ],
        "timezone_offset_min": 310
      },
      "expected": {
        "first_unix_timestamp_ms": 1,
        "sections_sizes": [3, 2],
        "inner_sections_durations_ms": [1, 10],
        "outer_sections_durations_ms": [0, 12],
        "sensors": [
          {
            "photoplethysmograph": {
              "color": "COLOR_RED"
            },
            "int_values": [0, 3, -2, 2, -1]
          },
          {
            "photoplethysmograph": {
              "color": "COLOR_GREEN"
            },
            "int_values": [3, 2, -3, -1, 3]
          },
          {
            "photoplethysmograph": {
              "color": "COLOR_BLUE"
            },
            "int_values": [0, 0, 0, 0, 0]
          },
          {
            "photoplethysmograph": {
              "wavelength_nm": 400
            },
            "int_values": [4, 2, -3, -1, 2]
          },
          {
            "accelerometer": {
              "type": "TYPE_X_COORDINATE"
            },
            "int_values": [0, 0, 0, -200, 200]
          },
          {
            "accelerometer": {
              "type": "TYPE_Y_COORDINATE"
            },
            "int_values": [0, 0, 0, 200, -200]
          },
          {
            "accelerometer": {
              "type": "TYPE_Z_COORDINATE"
            },
            "int_values": [0, 100, -100, -200, 200]
          },
          {
            "accelerometer": {
              "type": "TYPE_EUCLIDEAN_DIFFERENCES_NORM"
            },
            "double_values": [3.21274389, 8.723849, 400.782934, 43.83924, 64.34894]
          },
          {
            "electrocardiogram": {
              "channel": 1
            },
            "int_values": [0, 0, 0, 40, -40]
          },
          {
            "electrocardiogram": {
              "channel": 2
            },
            "int_values": [0, 40, -40, 20, -20]
          }
        ],
        "timezone_offset_min": 310
      }
    }
  ]
}
